# Optional Gemini fallback key. Regex parsing works when this is blank.
# NEVER commit a real key: set it in .env locally, or in your host's "Environment" settings when deployed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local dev: SQLite file (created automatically).
# Deployed: use a hosted Postgres URL so data survives restarts, e.g. from Neon / Supabase / Render Postgres.
DATABASE_URL=sqlite:///./data/takatrack.db

# Maximum SMS text upload size, in bytes.
MAX_UPLOAD_BYTES=1048576
